<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.eova</groupId>
        <artifactId>yudao-module-eova</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>eova-db-adapter</artifactId>
    <packaging>jar</packaging>
    <name>eova-db-adapter</name>
    <description>EOVA 数据访问适配层（DES-002-R4 §4：唯一允许接触数据源与事务的边界）</description>

    <dependencies>
        <!-- 依赖 eova-compat：复用其 enjoy 依赖提供的 com.jfinal.kit.TypeKit（类型转换语义） -->
        <!-- 【必须声明在最前】仅测试期引入旧 JFinal 制品，作为 EovaModel 的比对 oracle。
             位置不是随意的：enjoy 5.3.0（随 eova-compat 传递引入）与 jfinal 5.2.6
             都提供 com.jfinal.kit.*（TypeKit/TimeKit/Kv/Ret/...），谁生效取决于
             classpath 顺序。若 enjoy 先出现，旧侧会变成"jfinal 的 Model + enjoy 的 TypeKit"
             混合体 —— oracle 被污染，比对结果无意义（本轮实测即踩到，见 EovaModelGoldenTest 的
             来源自检断言）。放在最前可让 jfinal 的 com.jfinal.kit.* 先解析。
             生产代码绝不依赖 jfinal。 -->
        <dependency>
            <groupId>com.jfinal</groupId>
            <artifactId>jfinal</artifactId>
            <version>5.2.6</version>
            <scope>test</scope>
        </dependency>
        <!-- 数据访问层依赖内核：BaseModel 需要 EovaDataSource（数据源注册表/方言族）
             与 SqlUtil（Oracle 序列表达式）。方向为 compat -> core -> db-adapter，无环。 -->
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-compat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- eova-compat 的 test-jar：跨实现验证基建 -->
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-compat</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试用：与旧系统同源的 MySQL 驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.30</version>
            <scope>test</scope>
        </dependency>
        <!-- H2（test 作用域）：live readiness 冒烟要一条【真实 JDBC】链路。
             旧栈本身支持 h2 方言（EovaDbPro 对 h2 做关键字转义），故用 h2 内存库跑
             "真实 schema + 真实 SQL 变换 + 真实表元数据自省" 的端到端验收，
             不依赖 baseline MySQL。版本与 druid 无关，取当前仓库可用版本。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
