<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.eova</groupId>
        <artifactId>yudao-module-eova</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>eova-core</artifactId>
    <packaging>jar</packaging>
    <name>eova-core</name>
    <description>EOVA 框架无关内核（LC-011 逐文件 port）</description>

    <dependencies>
        <!-- 非业务兼容适配层：模板接缝、旧工具、序列化语义（DES-002-R4 §4：
             eova-core 需要旧能力时依赖 eova-compat） -->
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-compat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- eova-compat 的 test-jar：跨实现行为等价验证基建（OldImplementationLoader） -->
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-compat</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Servlet API：cn.eova.common.render.* 直接使用 response / render 出口
             （旧实现继承 jfinal Render 拿到 protected HttpServletResponse），
             故本模块自身需要 jakarta.servlet。
             注意 eova-compat 的该依赖是 provided，【不传递】，必须在此重复声明 ——
             漏声明会表现为"无法访问 jakarta.servlet.http.HttpServletResponse"。
             scope=provided：由 Servlet 容器提供。见 DES-002-R4 §B 面决策 1。 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- EOVA 官方工具库（门面 x 及其工具类）。
             替代原先手写的 cn.eova.tools.x compile-stub —— 该 stub 的 API 面与真实类不符
             （虚构了嵌套类 x.XLog / x.XStr，真实类型为 LogTool / StringTool），
             且缺少 BaseController 所需的 x.conf 字段。详见 DES-002-R4 §3.5。 -->
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-tools</artifactId>
        </dependency>
        <!-- bean 级 JSON 往返（MenuObject.config 等）—— 与旧工程同版本 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <!-- Mod 打包（EovaModPackage 用 hutool 的 FileUtil/ZipUtil） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- 定时任务（BaseTask / EovaCronPlugin 用 cron4j）—— 与旧工程同版本 -->
        <dependency>
            <groupId>it.sauronsoftware.cron4j</groupId>
            <artifactId>cron4j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>
        <!-- Excel 导出：cn.eova.common.utils.excel.ExceUtil 使用 org.ttzero.excel
             （Workbook / SimpleSheet / Column / style.Fill / PatternType / Styles）。
             版本由父 pom 的 dependencyManagement 统一管理（0.5.24，取自旧运行期 classpath 实录）。 -->
        <dependency>
            <groupId>org.ttzero</groupId>
            <artifactId>eec</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 旧侧 Servlet API（javax 命名空间，4.0.1）—— 仅测试用。
             BFacePortSurfaceGoldenTest 要把旧产物里的
             cn.eova.common.utils.HttpUtils / web.RequestUtil 加载上场，
             其方法签名的形参类型是 javax.servlet.http.*；对这些类做
             getDeclaredMethods() 时必须能解析这些类型，否则
             NoClassDefFoundError: javax/servlet/http/HttpServletRequest。
             主代码【不得】出现 javax.servlet（见本模块 jakarta.servlet-api 的 provided 依赖）。 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
