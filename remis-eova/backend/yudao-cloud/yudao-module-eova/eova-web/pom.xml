<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.eova</groupId>
        <artifactId>yudao-module-eova</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>eova-web</artifactId>
    <name>eova-web</name>
    <description>Eova 自有 Web 层（阶段 2）：容器接线，复用已 port 的 LegacyController/Routes/Render。
        设计见 docs/DES-005-R1-eova-web-layer-design.md。阶段 3 由平台形态取代，对外契约不变。
        边界：只依赖三个既有 eova 模块 + spring-boot-starter-web；**不依赖 yudao 平台 starter**。</description>

    <dependencies>
        <!-- ★ r310：**差分 oracle 专用**（test 作用域）。`LegacyPageRendererGoldenTest` 用**裸 enjoy 引擎**
             渲染同一份模板与数据，与本仓极简渲染器逐字节比对 —— 这是"自研渲染器与 enjoy 等价"的
             唯一直接证据，故保留；它**不参与**生产编译与运行（生产已零 com.jfinal 依赖）。 -->
        <dependency>
            <groupId>com.jfinal</groupId>
            <artifactId>enjoy</artifactId>
            <version>5.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-compat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.eova</groupId>
            <artifactId>eova-db-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ★ r328（阶段三 U8）：版本**不再硬编码**，交父 pom 的 `spring-boot-dependencies` BOM 管
             （原写死 3.4.5 ⇒ 父 pom 升级后会静默漂移；平台全走 BOM）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ★ r328（阶段三 U2/U5，DES-011 A 级）：与平台同构的**注册中心 + 配置中心 + 健康检查**。
             版本由父 pom 的 SC / SCA BOM 管（2024.0.1 / 2023.0.3.2，与 platform 逐字同版本）。
             口径（拿哥 r327 ①）：**独立 reactor + 边缘集成** —— 引这两个 starter 是为了"能被平台网关
             发现 + 能接平台 Nacos 配置"，**不引**平台内部库（cn.iocoder.cloud:*）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 测试作用域：真自省/真库判据需要驱动；main 不加（驱动由运行时提供） -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.30</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- ★ r328（阶段三 U6，DES-011 A 级）：**可执行 jar 形态**（`java -jar`）。
             平台侧 k8s/Dockerfile 全部以可执行 jar 为单位（`Dockerfile:23` = `java -jar app.jar`，
             `yudao-server/pom.xml:158-175` = repackage + `finalName=${project.artifactId}`）⇒ 新栈要有
             同样的发布形态，否则进不了 k8s。
             ⚠️ 已知边界（登记）：金仓驱动在 maven 里是 **test 作用域**（`eova-db-adapter/pom.xml`），
             fat jar **不含**它 ⇒ 金仓档部署时须把驱动随包提供（见 ledger 的部署口径）。 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 只 repackage 本模块的可执行入口（eova-web 的 EovaWebApplication） -->
                    <mainClass>cn.eova.web.EovaWebApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
